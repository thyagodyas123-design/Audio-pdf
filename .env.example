TTS_PROVIDER=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth

# Vídeo-aula (roteiro por LLM). Qualquer provedor compatível com a API de chat da OpenAI.
# Nunca versione o .env nem cole a chave em chats: se vazar, revogue e gere outra.
OPENCODE_API_KEY=
# LLM_API_KEY=            # alternativa genérica (tem prioridade)
# LLM_BASE_URL=https://opencode.ai/zen/v1
# LESSON_MODEL=gemini-3.8-flash
# Para custo zero com IA: servidor local (Ollama/LM Studio) dispensa chave, ex.:
# LLM_BASE_URL=http://localhost:11434/v1
# LESSON_MODEL=qwen2.5:7b-instruct
# Teto de texto enviado ao LLM por capítulo (controla o custo; padrão 20000 caracteres ≈ 6 mil tokens):
# LESSON_BUDGET_CHARS=20000

# Acesso: o app exige login. No primeiro start, sem nenhum usuário, cria o administrador com estas variáveis
# (depois disso elas são ignoradas; gerencie as contas na tela "Usuários"). Os livros que já existiam passam a ser dele.
ADMIN_EMAIL=
ADMIN_PASSWORD=          # 8 a 128 caracteres; troque pela tela depois do primeiro login
# ADMIN_NAME=Administrador
# Postgres em produção (o docker-compose já define). Sem isto usa SQLite em AUDIOPDF_DATA/audiopdf.db.
# DATABASE_URL=postgresql+psycopg://audiopdf:senha@db:5432/audiopdf
# Com HTTPS (Traefik/Dokploy) o cookie de sessão sai com o atributo Secure:
# PUBLIC_URL=https://audio-pdf.exemplo.com.br
